# ==========================================
# Fonte única de configuração do projeto.
# Copie para `.env` e preencha os valores.
# Toda porta / credencial / dado sensível parte daqui.
# ==========================================

# ── Backend (Node.js + Express) ───────────
NODE_ENV = development
NODE_PORT = 3000

# ── Fuso horário dos containers ───────────
# Aplicado a backend, frontend e banco no docker-compose.
TZ = America/Sao_Paulo

# ── Frontend (Vue + Vite) ─────────────────
FRONTEND_PORT = 5173

# ── Banco de Dados (MongoDB) ──────────────
DATA_BASE_USER =
DATA_BASE_PASSWORD =
DATA_BASE_NAME =
DATA_BASE_PORT = 27017
